# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (Project Settings → API Keys) ----------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server only, never exposed to the browser: the secret key (sb_secret_…); SUPABASE_SERVICE_ROLE_KEY (legacy) also works
SUPABASE_SECRET_KEY=

# ---------- Clerk (admin sign-in; Dashboard → API keys) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/sign-up

# ---------- Resend (email) ----------
RESEND_API_KEY=
EMAIL_FROM="Smash Corner <noreply@smashcorner-qc.com>"
# where contact-form messages go
CONTACT_INBOX=hello@smashcorner-qc.com
# testing before the domain is verified: send every email to this one address (the Resend account email)
EMAIL_TEST_TO=
# true = print emails to the server console instead of sending (also automatic when RESEND_API_KEY is empty)
EMAIL_DRY_RUN=false

# ---------- Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))") ----------
# signs payment-page and waitlist-claim links
LINK_SECRET=
# shared with the Supabase pg_cron job (supabase/migrations/0002_cron.sql)
CRON_SECRET=

# ---------- Optional ----------
# Google Maps embed URL for the Contact page (Maps → Share → Embed a map → src)
NEXT_PUBLIC_MAP_EMBED_URL=
# FullCalendar Scheduler commercial licence key (falls back to the non-commercial evaluation key)
NEXT_PUBLIC_FULLCALENDAR_LICENSE=
